<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>UnjudgedSins</defName>
        <workerClass>Determination.ThoughtWorker_Sin</workerClass>
        <validWhileDespawned>true</validWhileDespawned>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>unjudged sins (1)</label>
                <description>I gained LV. I'll need to be judged at some point...</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
            <li>
                <label>unjudged sins (2)</label>
                <description>I've gained another level. I need to be judged to clear my conscience.</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
            <li>
                <label>unjudged sins (3)</label>
                <description>I've gained three levels since my last judgement. That's far too long.</description>
                <baseMoodEffect>-12</baseMoodEffect>
            </li>
            <li>
                <label>unjudged sins (4)</label>
                <description>I must be judged. I can feel sin weighing heavily on me.</description>
                <baseMoodEffect>-16</baseMoodEffect>
            </li>
            <li>
                <label>unjudged sins (5)</label>
                <description>I am crushed under the weight of my sins. I must undergo judgement as soon as possible.</description>
                <baseMoodEffect>-20</baseMoodEffect>
            </li>
        </stages>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ThreateningJudgement</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>threatened by judge</label>
                <description>Have I really been so evil? Did I really deserve to be threatened like that?</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>NegativeJudgement</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>4</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>negative judgement</label>
                <description>That wasn't a pleasant judgement, but at least my sins have been lifted.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>NeutralJudgement</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>3</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>neutral judgement</label>
                <description>That could have gone worse. The judge had some good things to say about me.</description>
                <baseMoodEffect>+1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>PositiveJudgement</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>positive judgement</label>
                <description>That judgement left me beaming with pride, and all my sins were lifted as well.</description>
                <baseMoodEffect>+8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>