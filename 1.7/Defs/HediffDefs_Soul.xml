<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>SoulLossShock</defName>
        <label>soul loss shock</label>
        <labelNoun>soul loss shock</labelNoun>
        <description>A state of impaired brain function caused by the sudden removal of the individual's soul. This will recover over approximately one day, but the other effects of soullessness may not be so kind.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(1,0,1)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>wearing off</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.35</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>dazed</label>
                <minSeverity>0.5</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.5</setMax>
                    </li>
                </capMods>
            </li>
            <li>
                <label>comatose</label>
                <minSeverity>0.75</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>SoulRebellion</defName>
        <label>soul rebellion</label>
        <labelNoun>a soul rebellion</labelNoun>
        <description>The souls that this individual once controlled are rebelling. They will punish their former captor with burns across the body before they leave forever.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(1,0.2,0.2)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>7500</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
        <stages>
            <li>
                <label>active</label>
                <painOffset>1</painOffset>
                <hediffGivers>
                    <li Class="HediffGiver_Random">
                        <hediff>Burn</hediff>
                        <mtbDays>0.1</mtbDays>
                        <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>RebellionShock</defName>
        <label>soul rebellion shock</label>
        <labelNoun>soul rebellion shock</labelNoun>
        <description>The souls that this individual once controlled have rebelled. In their absence the body is struggling to sustain its basic functions.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(1,0.3,0.3)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>wearing off</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.15</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>dazed</label>
                <minSeverity>0.5</minSeverity>
                <painOffset>0.1</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.75</setMax>
                    </li>
                </capMods>
            </li>
            <li>
                <label>weakened</label>
                <minSeverity>0.75</minSeverity>
                <painOffset>0.2</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.5</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <!-- Determination-->
    <HediffDef>
        <defName>DeterminationOverload</defName>
        <label>determination overload</label>
        <labelNoun>determination overload</labelNoun>
        <description>This creature has a dangerously high level of active determination in its bloodstream. This will wear off eventually, and when it does it will cause a hangover depending on the severity it reached. High severity can also cause burns to random body parts.</description>
        <hediffClass>Determination.Hediff_DeterminationOverload</hediffClass>
        <defaultLabelColor>(1,1,0)</defaultLabelColor>
        <initialSeverity>0.7</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>minor</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.2</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>major</label>
                <minSeverity>0.5</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.5</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>extreme</label>
                <minSeverity>0.85</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>1</offset>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_Random">
                    <hediff>Burn</hediff>
                    <mtbDays>0.1</mtbDays>
                    <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>
    <HediffDef>
        <defName>DeterminationHangover</defName>
        <label>determination hangover</label>
        <labelNoun>a determination hangover</labelNoun>
        <description>The result of using too much determination too quickly. For humans this takes the form of reduced consciousness and a pounding headache. Monsters aren't so lucky.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(1,0.7,0)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>wearing off</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.05</offset>
                    </li>
                </capMods>
                <painOffset>0.1</painOffset>
            </li>
            <li>
                <label>lingering</label>
                <minSeverity>0.5</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.2</offset>
                    </li>
                </capMods>
                <painOffset>0.2</painOffset>
            </li>
            <li>
                <label>painful</label>
                <minSeverity>1</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.5</setMax>
                    </li>
                </capMods>
                <painOffset>0.3</painOffset>
            </li>
            <li>
                <label>agonizing</label>
                <minSeverity>2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.4</setMax>
                    </li>
                </capMods>
                <painOffset>0.8</painOffset>
            </li>
            <li>
                <label>blackout</label>
                <minSeverity>3</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
                <painOffset>1</painOffset>
            </li>
        </stages>
    </HediffDef>


    <HediffDef>
        <defName>DeadAndSoullessHidden</defName>
        <label>Dead and soulless</label>
        <description>This is hidden. You shouldn't be able to see this.</description>
        <hediffClass>Determination.Hediff_DeadAndSoullessHidden</hediffClass>
        <stages>
            <li>
                <label>hidden</label>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>DeterminationDeficiency</defName>
        <label>determination deficiency</label>
        <description>Due to a lack of determination, the body is unable to sustain vital processes. A determination deficiency is usually the result of a damaged or missing soul. This condition will gradually erode capacities until the affected individual dies. Determination deficiency can be reduced via regular determination injections.</description>
        <defaultLabelColor>(0.8, 0, 0)</defaultLabelColor>
        <lethalSeverity>1</lethalSeverity>
        <initialSeverity>0.001</initialSeverity>
        <hediffClass>Determination.Hediff_DeterminationDeficiency</hediffClass>
        <stages>
            <li>
                <label>initial</label>
                <becomeVisible>false</becomeVisible>
            </li>
            <li>
                <label>initial</label>
                <minSeverity>0.04</minSeverity>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.05</offset>
                </li>
                </capMods>
            </li>
            <li>
                <label>minor</label>
                <minSeverity>0.2</minSeverity>
                <capMods>
                <li>
                    <capacity>Moving</capacity>
                    <offset>-0.1</offset>
                </li>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.10</offset>
                </li>
                </capMods>
            </li>
            <li>
                <label>serious</label>
                <minSeverity>0.35</minSeverity>
                <painOffset>0.15</painOffset>
                <capMods>
                <li>
                    <capacity>Moving</capacity>
                    <offset>-0.3</offset>
                </li>
                <li>
                    <capacity>Consciousness</capacity>
                    <offset>-0.20</offset>
                </li>
                </capMods>
            </li>
            <li>
                <label>extreme</label>
                <minSeverity>0.62</minSeverity>
                <lifeThreatening>true</lifeThreatening>
                <painOffset>0.30</painOffset>
                <capMods>
                <li>
                    <capacity>Consciousness</capacity>
                    <setMax>0.1</setMax>
                </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>BossMonsterSoulAbsorbed</defName>
        <label>absorbed boss soul</label>
        <labelNoun>an absorbed boss soul</labelNoun>
        <description>This human has absorbed the soul of a boss monster. It now wields incredible power. A human may absorb up to three souls.</description>
        <defaultLabelColor>(0.68,0.54,1)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <stages>
            <!-- One absorbed-->
            <li>
                <minSeverity>1</minSeverity>
                <label>1</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>2</offset>
                    </li>
                </capMods>
                <statFactors>
                    <IncomingDamageFactor>0.30</IncomingDamageFactor>
                    <MeleeDamageFactor>3</MeleeDamageFactor>
                </statFactors>
                <disablesNeeds>
                    <li>Rest</li>
                    <li>Food</li>
                    <li>Comfort</li>
                </disablesNeeds>
                <painFactor>0.5</painFactor>
                <regeneration>60</regeneration>
            </li>
            <!-- Two absorbed-->
            <li>
                <minSeverity>2</minSeverity>
                <label>2</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>2.25</offset>
                    </li>
                </capMods>
                <statFactors>
                    <IncomingDamageFactor>0.25</IncomingDamageFactor>
                    <MeleeDamageFactor>4</MeleeDamageFactor>
                </statFactors>
                <disablesNeeds>
                    <li>Rest</li>
                    <li>Food</li>
                    <li>Comfort</li>
                </disablesNeeds>
                <painFactor>0.4</painFactor>
                <regeneration>60</regeneration>
                <totalBleedFactor>0.5</totalBleedFactor>
            </li>
            <!-- Three absorbed-->
            <li>
                <minSeverity>3</minSeverity>
                <label>3</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>2.75</offset>
                    </li>
                </capMods>
                <statFactors>
                    <IncomingDamageFactor>0.25</IncomingDamageFactor>
                    <MeleeDamageFactor>4</MeleeDamageFactor>
                </statFactors>
                <disablesNeeds>
                    <li>Rest</li>
                    <li>Food</li>
                    <li>Comfort</li>
                </disablesNeeds>
                <painFactor>0.3</painFactor>
                <regeneration>100</regeneration>
                <totalBleedFactor>0</totalBleedFactor>
            </li>
        </stages>
    </HediffDef>
</Defs>