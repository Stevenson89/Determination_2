<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MonsterDeterminationOverload</defName>
        <label>determination overload</label>
        <description>This creature has a dangerously high level of active determination in its bloodstream. This must be resolved quickly via a determination reduction surgery or else the patient risks melting... Or worse.</description>
        <hediffClass>Determination.Hediff_MonsterDeterminationOverload</hediffClass>
        <defaultLabelColor>(1,1,0)</defaultLabelColor>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-1</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>minor</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.2</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>melting</label>
                <minSeverity>0.2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.5</offset>
                    </li>
                </capMods>
                <hediffGivers>
                    <li Class="HediffGiver_Random">
                    <hediff>DeterminationMelted</hediff>
                    <mtbDays>0.05</mtbDays>
                    <canAffectAnyLivePart>true</canAffectAnyLivePart>
                    </li>
                </hediffGivers>
            </li>
            <li>
                <label>stable</label>
                <minSeverity>0.8</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>1</offset>
                    </li>
                </capMods>
                <totalBleedFactor>0</totalBleedFactor>
                <painFactor>0</painFactor>
            </li>
        </stages>
    </HediffDef>



    <HediffDef>
        <defName>DeterminationMelted</defName>
        <label>melting</label>
        <description>This part of the body has begun to melt under the weight of determination. It will lose function in two stages. In stage one it is reversible by reducing the determination, but stage two cannot be cured.</description>
        <hediffClass>Determination.Hediff_DeterminationMelt</hediffClass>
        <defaultLabelColor>(0.8,0.8,0.8)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <stages>
            <li>
                <label>melting</label>
                <partEfficiencyOffset>-0.25</partEfficiencyOffset>
            </li>
            <li>
                <label>melted</label>
                <minSeverity>1</minSeverity>
                <partEfficiencyOffset>-1</partEfficiencyOffset>
            </li>
        </stages>
    </HediffDef>
</Defs>