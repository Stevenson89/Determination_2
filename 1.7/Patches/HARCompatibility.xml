<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Humanoid Alien Races</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[not(comps)]</xpath>
                    <value>
                        <comps />
                    </value>
                    <success>Always</success>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[not(@Abstract="True")]/comps</xpath>
                    <value>
                        <li>
                            <compClass>Determination.CompSoul</compClass>
                        </li>
                    </value>
                    <success>Always</success>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>